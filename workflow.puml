@startuml
skinparam DefaultFontName Arial
skinparam BackgroundColor transparent
skinparam activity {
  BackgroundColor White
  BorderColor #334155
  DiamondBackgroundColor #E2E8F0
  DiamondBorderColor #334155
}

title Resumable State-v3 Inbox-to-Commit Workflow

start
:Watch inbox for stable Markdown task;
:Read task, repository policy, Git identity, and persisted state;

if (New watch task?) then (yes)
  :Create, switch to, or extend TARGET_BRANCH under safe worktree rules;
else (formal single task)
  :Require the declared active target branch;
endif

if (Only prose plus TARGET_BRANCH?) then (yes)
  :Derive PLAN_ONLY and exact docs/internal slug work-plan scope;
else (formal contract)
  :Validate every declared contract marker fail-closed;
endif

if (Unfinished State-v3 run?) then (yes)
  :Resume the persisted work unit, slice, round, and exact role step;
else (no)
  :Create State-v3 work unit;
endif

if (Approved IMPLEMENT handoff?) then (yes)
  :Verify APPROVED_PLAN_COMMIT and imported slices;
else (plan required)
  partition "Plan" {
    :Codex produces one plan-artifact SLICE_PLAN and documents future slices;
    :Orchestrator validates task scope and the internal plan/handoff contract;
    :Claude reviews the plan;
    :Antigravity reviews the same plan fingerprint;
    while (PLAN_APPROVAL is NO?) is (yes)
      :Codex revises the plan and answers findings;
      :Orchestrator refreshes bound evidence;
      :Claude and Antigravity review the plan correction;
    endwhile (no)
    if (Manual plan gate enabled?) then (yes)
      :Persist fingerprint-bound plan gate;
      :User reviews and resumes with --approve-gate;
    else (automatic default)
    endif
    :Create and verify local plan commit;
    :Generate IMPLEMENT handoff and queue it next;
  }
endif

while (A planned slice remains?) is (yes)
  partition "Bounded slice" {
    :Create Slice audit document;
    :Persist slice start commit and exact path scope;
    :Codex implements within the scope;
    if (Agent sandbox blocks port/browser validation?) then (yes)
      :Re-prompt Codex once for normal readiness;
      :Leave the full matrix to the orchestrator;
    else (no)
    endif
    :Orchestrator collects canonical diff and runs validation once per fingerprint;
    :Claude reviews changed paths and hunks;

    while (Claude has an open blocker?) is (yes)
      :Codex corrects and answers findings;
      :Orchestrator validates the new fingerprint;
      :Claude reviews only the correction delta;
    endwhile (no)

    :Antigravity reviews the complete slice diff;
    while (Antigravity has an open blocker?) is (yes)
      :Codex corrects and answers findings;
      :Orchestrator validates the new fingerprint;
      :Claude reviews the correction delta;
      :Antigravity rechecks its findings;
    endwhile (no)

    if (Enabled manual gate or true policy stop?) then (yes)
      :Persist awaiting_user_decision;
      :Return exit 4 without changing the reviewed worktree;
      :User repairs or decides the gate and runs --resume;
      :Revalidate the persisted boundary and fingerprint;
    else (automatic default)
    endif
    :Orchestrator stages exact reviewed paths;
    :Create and verify local Slice NN commit;
  }
endwhile (no)

partition "Branch-wide final review" {
  :Codex checks completeness against the full branch diff;
  :Orchestrator validates and attests the branch fingerprint;
  :Claude reviews the complete branch;
  :Antigravity reviews the same complete branch;

  while (Any final finding remains open?) is (yes)
    if (Actionable defect?) then (yes)
      :Finding owner reclassifies it as a blocker;
      :Create a bounded correction work unit;
      :Codex corrects, validation runs, and both slice reviewers approve;
      :Orchestrator creates a local correction commit;
    else (no)
      :Finding owner closes it as resolved,
      non-issue, or outside authorized scope;
    endif
    :Repeat the complete branch review;
  endwhile (no)
}

:Persist completed State v3;
:Move original task to outbox/done;
:STATUS: DONE;
stop

legend right
  Exit 2 = quota halt
  Exit 3 = agent-instance halt
  Exit 4 = user or policy gate
  Every halt is checkpointed before return.
endlegend
@enduml
