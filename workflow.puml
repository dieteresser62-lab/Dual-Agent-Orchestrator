@startuml
skinparam DefaultFontName Arial
skinparam BackgroundColor transparent
skinparam activity {
  BackgroundColor White
  BorderColor #334155
  DiamondBackgroundColor #E2E8F0
  DiamondBorderColor #334155
}

title Resumable Structured-v2 Codex-Claude Workflow

start
:Watch inbox for stable Markdown task;
:Read task, repository policy, Git identity, and persisted state;

if (New watch task?) then (yes)
  :Prepare TARGET_BRANCH under safe worktree rules;
else (formal single task)
  :Require the declared active target branch;
endif

if (Only prose plus TARGET_BRANCH?) then (yes)
  :Derive PLAN_ONLY and exact work-plan scope;
else (formal contract)
  :Validate every declared contract marker fail-closed;
endif

if (Unfinished State-v3 run?) then (yes)
  if (Persisted protocol is structured-v2?) then (yes)
    :Scan authoritative append-only records and rebuild head cache;
    :Compare record facts with the State-v3 operational mirror;
    if (Chain missing, corrupt, unknown, or divergent?) then (yes)
      :Halt fail-closed with run/record diagnosis;
      stop
    else (consistent)
      :Resume exact work unit, slice, round, role, model, and effort;
    endif
  else (unsupported)
    :Reject legacy-state-v3 or structured-v1 with UNSUPPORTED-PROTOCOL;
    stop
  endif
else (no)
  :Create State-v3 work unit and bind structured-v2 plus agent profiles;
endif

if (Approved IMPLEMENT handoff?) then (yes)
  :Verify APPROVED_PLAN_COMMIT and imported slices;
else (plan required)
  partition "Plan" {
    :Codex returns native JSON SLICE_PLAN result;
    :Validate task scope and plan/handoff contract;
    :Run deterministic plan checks;
    :Claude reviews the bound plan fingerprint;
    while (PLAN_APPROVAL is NO?) is (yes)
      :Codex returns a native JSON plan correction;
      :Refresh bound evidence and Claude reviews again;
    endwhile (no)
    if (Manual plan gate enabled?) then (yes)
      :Persist fingerprint-bound plan gate;
      :User reviews and resumes with --approve-gate;
    else (automatic default)
    endif
    :Create and verify local plan commit;
    :Generate IMPLEMENT handoff and queue it next;
  }
endif

while (A planned slice remains?) is (yes)
  partition "Bounded slice" {
    :Create Slice audit document and persist exact scope;
    :Codex implements and returns native JSON readiness;
    :Append validated records before any workflow decision;
    :Dual-write the State-v3 mirror and prove semantic equality;
    :Collect canonical diff and run validation once per fingerprint;
    :Claude reviews the bound diff and attestation;
    while (Claude has an open blocker?) is (yes)
      :Codex corrects and answers findings;
      :Validate the new fingerprint;
      :Claude reviews the correction delta;
    endwhile (no)
    if (Enabled manual gate or true policy stop?) then (yes)
      :Persist awaiting_user_decision and return exit 4;
      :User repairs or decides the gate and resumes;
      :Revalidate the persisted boundary and fingerprint;
    else (automatic default)
    endif
    :Stage exact Claude-approved paths;
    :Create and verify local Slice NN commit;
  }
endwhile (no)

partition "Branch-wide final review" {
  :Codex checks completeness against the full branch diff;
  :Validate and attest the branch fingerprint;
  :Claude reviews the complete branch and pre-mortem;
  while (Any final finding remains open?) is (yes)
    :Create a bounded correction work unit;
    :Codex corrects, validation runs, and Claude reviews;
    :Create a local correction commit;
    :Repeat the complete branch review;
  endwhile (no)
}

:Persist completed State v3;
:Move original task to outbox/done;
:STATUS: DONE;
stop

legend right
  Exit 2 = quota halt
  Exit 3 = agent-instance halt
  Exit 4 = user or policy gate
  Every halt is checkpointed before return.
endlegend
@enduml
