{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "native-agent-codex-result-v1",
  "title": "Native Codex result v1",
  "oneOf": [
    { "$ref": "#/$defs/plan_result" },
    { "$ref": "#/$defs/implementation_result" },
    { "$ref": "#/$defs/correction_result" },
    { "$ref": "#/$defs/final_report_result" },
    { "$ref": "#/$defs/stop_result" }
  ],
  "$defs": {
    "request_id": {
      "type": "string",
      "pattern": "^native-codex-request-[0-9a-f]{64}$"
    },
    "safe_text": {
      "type": "string",
      "pattern": "^(?=.*\\S)[^\\u0000]{1,12000}$"
    },
    "safe_path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000\\r\\n]{1,1000}$"
    },
    "finding_disposition": {
      "type": "object",
      "properties": {
        "finding_id": {
          "type": "string",
          "pattern": "^[CA]-(0[1-9]|[1-9][0-9]*)$"
        },
        "decision": { "enum": ["accepted", "rejected"] },
        "rationale": { "$ref": "#/$defs/safe_text" }
      },
      "required": ["finding_id", "decision", "rationale"],
      "additionalProperties": false
    },
    "planned_slice": {
      "type": "object",
      "properties": {
        "slice_id": { "type": "integer", "minimum": 1 },
        "summary": { "$ref": "#/$defs/safe_text" },
        "scope_paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/safe_path" }
        }
      },
      "required": ["slice_id", "summary", "scope_paths"],
      "additionalProperties": false
    },
    "plan_result": {
      "type": "object",
      "properties": {
        "schema_version": { "const": "native-agent-codex-result-v1" },
        "result_type": { "const": "plan_result" },
        "request_id": { "$ref": "#/$defs/request_id" },
        "ready": { "type": "boolean" },
        "slice_plan": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/planned_slice" }
        },
        "finding_dispositions": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/finding_disposition" }
        }
      },
      "required": ["schema_version", "result_type", "request_id", "ready", "slice_plan"],
      "additionalProperties": false
    },
    "implementation_result": {
      "type": "object",
      "properties": {
        "schema_version": { "const": "native-agent-codex-result-v1" },
        "result_type": { "const": "implementation_result" },
        "request_id": { "$ref": "#/$defs/request_id" },
        "ready": { "type": "boolean" },
        "test_files": {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/safe_path" }
        },
        "finding_dispositions": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/finding_disposition" }
        }
      },
      "required": ["schema_version", "result_type", "request_id", "ready", "test_files", "finding_dispositions"],
      "additionalProperties": false
    },
    "correction_result": {
      "type": "object",
      "properties": {
        "schema_version": { "const": "native-agent-codex-result-v1" },
        "result_type": { "const": "correction_result" },
        "request_id": { "$ref": "#/$defs/request_id" },
        "ready": { "type": "boolean" },
        "test_files": {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/safe_path" }
        },
        "finding_dispositions": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/finding_disposition" }
        }
      },
      "required": ["schema_version", "result_type", "request_id", "ready", "test_files", "finding_dispositions"],
      "additionalProperties": false
    },
    "final_report_result": {
      "type": "object",
      "properties": {
        "schema_version": { "const": "native-agent-codex-result-v1" },
        "result_type": { "const": "final_report_result" },
        "request_id": { "$ref": "#/$defs/request_id" },
        "ready": { "type": "boolean" },
        "finding_dispositions": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/finding_disposition" }
        },
        "self_check": { "$ref": "#/$defs/safe_text" }
      },
      "required": ["schema_version", "result_type", "request_id", "ready", "finding_dispositions", "self_check"],
      "additionalProperties": false
    },
    "stop_result": {
      "type": "object",
      "properties": {
        "schema_version": { "const": "native-agent-codex-result-v1" },
        "result_type": { "const": "stop_result" },
        "request_id": { "$ref": "#/$defs/request_id" },
        "rule_id": { "$ref": "#/$defs/safe_text" },
        "rationale": { "$ref": "#/$defs/safe_text" },
        "remediation_paths": {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/safe_path" }
        }
      },
      "required": ["schema_version", "result_type", "request_id", "rule_id", "rationale", "remediation_paths"],
      "additionalProperties": false
    }
  }
}
